# Local overrides — copied to .env.local (gitignored).
# Loaded after .env; values here win when both files define the same key.
#
# Typical use: QStash dev server while keeping production QStash in .env.
# 1. Run: npx @upstash/qstash-cli dev
# 2. Paste the printed values below into .env.local
# 3. Restart: npm run dev

QSTASH_URL=http://127.0.0.1:8080
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Not needed when using qstash-cli dev (local QStash can call localhost):
# UPSTASH_WORKFLOW_URL=
