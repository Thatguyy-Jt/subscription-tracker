# Server
PORT=3000

# Local overrides: copy .env.local.example to .env.local (gitignored).
# .env.local is loaded after .env and overrides matching keys — use it for
# qstash-cli dev credentials without changing production values in .env.

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/subscription-tracker

# JWT (use a long random string in production)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Optional: JWT HTTP-only cookie name (set by /auth/register|login; cleared by /auth/logout). Default accessToken.
# AUTH_ACCESS_COOKIE_NAME=accessToken

# Arcjet — https://app.arcjet.com (required for API rate limiting)
ARCJET_KEY=

# Local dev: when the client IP cannot be resolved, Arcjet defaults to 127.0.0.1 so rate limiting still works.
# Omit in production (or rely on NODE_ENV=production).
# ARCJET_ENV=development

# Sliding-window max requests per client IP per minute (default 200). Use e.g. 5 for quick local testing.
# ARCJET_RATE_LIMIT_MAX=5

# Decide API timeout (ms). Very low timeouts can yield ERROR decisions; middleware fails open so no 429 is returned.
# ARCJET_TIMEOUT_MS=3000

# Log every Arcjet decision (conclusion, remaining, client socket) — noisy; for debugging only.
# ARCJET_TRACE=1

# Upstash QStash / Workflow — https://console.upstash.com/qstash
# Local dev: run `npx @upstash/qstash-cli dev` and paste the printed values.
QSTASH_URL=
QSTASH_TOKEN=

# Workflow request verification (production / signed requests)
# https://upstash.com/docs/workflow/howto/security
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# REQUIRED for local dev with cloud QStash — QStash cannot call 127.0.0.1.
# 1. Start API: npm run dev
# 2. In another terminal: ngrok http 3000
# 3. Paste the https forwarding URL here (no trailing slash):
UPSTASH_WORKFLOW_URL=

# Reminder workflow (see src/config/upstash.ts)
# REMINDER_WORKFLOW_PATH=/api/workflows/reminders
# Comma-separated days before renewal to send upcoming reminder emails (default 7,5,2,1)
# REMINDER_UPCOMING_DAYS_BEFORE=7,5,2,1

# Email (Nodemailer SMTP) — required for reminder emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Admin users: register via POST /auth/register, then set role in MongoDB, e.g.
# db.users.updateOne({ email: "you@example.com" }, { $set: { role: "admin" } })
